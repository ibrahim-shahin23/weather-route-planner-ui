# Only needed when the API is on a different origin than the frontend.
# VITE_API_BASE_URL=https://api.example.com

# Map Tile Configuration
# Carto Voyager raster tiles (base URL and optional key)
VITE_TILE_BASE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
VITE_TILE_KEY=

# Fallback Map Tiles (OpenStreetMap tiles; no API key required)
VITE_FALLBACK_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
