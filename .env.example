# Only needed when the API is on a different origin than the frontend.
# VITE_API_BASE_URL=https://api.example.com

# Basemap: by default the free, keyless OpenFreeMap "Positron" vector style is used.
# Use a different MapLibre style (e.g. self-hosted):
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Or use a plain raster tile URL instead (overrides the vector style). Respect the provider's usage terms;
# the public OSM tile server is meant for light use only.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
